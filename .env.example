# =====================================================================
# IFMG Alimenta (PNAE) — modelo de variáveis de ambiente
# ---------------------------------------------------------------------
# Copie para .env e preencha. O .env NUNCA é versionado.
#   cp .env.example .env
# =====================================================================

# -- Django ------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/Sao_Paulo

# -- Banco de dados (PostgreSQL) --------------------------------------
# Em PRODUÇÃO a DATABASE_URL é derivada de POSTGRES_* pelo docker-compose.yml,
# então basta definir POSTGRES_DB/USER/PASSWORD (a linha DATABASE_URL abaixo
# pode ficar como está ou ser removida). Em DEV local ela é usada direto.
# POSTGRES_PASSWORD: use só letras/números/-/_ (senha vira URL). Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
DATABASE_URL=postgres://django_user:django_password@db:5432/django_db
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_password

# -- Proxy / HTTPS (produção) -----------------------------------------
# Em dev local (sem proxy) deixe USE_HTTPS_PROXY=False.
# Em produção (OVM-1) defina True e o domínio no ALLOWED_HOSTS/CSRF abaixo.
USE_HTTPS_PROXY=False
CSRF_TRUSTED_ORIGINS=

# Exemplo de produção (pnae.lucianovilasboas.com.br):
#   DEBUG=False
#   ALLOWED_HOSTS=pnae.lucianovilasboas.com.br
#   CSRF_TRUSTED_ORIGINS=https://pnae.lucianovilasboas.com.br
#   USE_HTTPS_PROXY=True
#   POSTGRES_PASSWORD=<hex forte gerado>
#
# Dica: rode ./scripts/deploy.sh (valida tudo) e, se mudou a senha depois de um
# 'up' anterior, use ./scripts/deploy.sh --reset-db.
