# Normaliza fim de linha para LF em todos os arquivos de texto.
* text=auto eol=lf

# Binários — não normalizar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.xls binary

# Marcação de linguagem (destaque no diff/GitHub).
*.py text diff=python
*.html text diff=html
*.md text diff=markdown
*.yml text
*.yaml text
